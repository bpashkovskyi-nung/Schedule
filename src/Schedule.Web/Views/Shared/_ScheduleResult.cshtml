@model ScheduleResultVm?

@if (Model is null)
{
    return;
}

<div class="card mt-4">
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.ExportUrl))
        {
            <div class="d-flex justify-content-end mb-3">
                <a href="@Model.ExportUrl" class="btn btn-outline-success btn-sm" target="_blank" rel="noopener">
                    <i class="bi bi-download"></i> Експорт iCal
                </a>
            </div>
        }

        @if (!Model.HasItems)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-calendar-x fs-1"></i>
                <p class="mt-3">На обраний період розклад не знайдено</p>
            </div>
        }
        else
        {
            <h5 class="mb-3">Розклад для: @Model.Title</h5>

            @if (Model.GroupedByDate is not null)
            {
                <div class="row">
                    @foreach (KeyValuePair<string, IReadOnlyList<ScheduleItemVm>> day in Model.GroupedByDate)
                    {
                        <div class="col-md-6 mb-3">
                            @await Html.PartialAsync("_DayScheduleCard", day)
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>
