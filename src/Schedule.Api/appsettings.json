{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ScheduleApi": {
    "MaxScheduleDays": 93,
    "MaxLoadDays": 31,
    "AuditoriumConcurrency": 4,
    "ReferenceCacheMinutes": 10,
    "ExternalRequestTimeoutSeconds": 60,
    "ExternalRetryCount": 2,
    "WorkloadPermitLimit": 2,
    "WorkloadWindowSeconds": 30,
    "EnableOpenApi": false,
    "TimetableBaseUrl": "https://dekanat.nung.edu.ua/cgi-bin/timetable.cgi"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5276",
      "https://localhost:5001",
      "https://schedule.nung.edu.ua"
    ]
  }
}
