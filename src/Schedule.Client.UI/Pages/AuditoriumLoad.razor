@page "/auditorium-load"
@inject IScheduleApiClient ApiClient
@inject ReferenceDataState ReferenceState

<PageTitle>Завантаження аудиторій</PageTitle>
<h1>Завантаження аудиторій</h1>
<p class="muted">Частка зайнятих пар у робочі дні обраного періоду.</p>

@if (ReferenceState.IsLoading)
{
    <LoadingIndicator Message="Завантаження корпусів…" />
}
else if (ReferenceState.Data is null)
{
    <ErrorAlert Message="@(ReferenceState.ErrorMessage ?? "Не вдалося завантажити довідники.")" />
}
else
{
    <section class="search-panel">
        <div class="form-grid">
            <label class="form-grid__wide">
                Корпус
                <select @bind="building">
                    <option value="">Усі корпуси</option>
                    @foreach (BuildingDto item in ReferenceState.Data.Buildings)
                    {
                        <option value="@item.Name">@item.Name</option>
                    }
                </select>
            </label>
            <label>
                Від дати
                <input type="date" @bind="fromDate" />
            </label>
            <label>
                До дати
                <input type="date" @bind="toDate" />
            </label>
            <label>
                Пари від
                <input type="number" min="1" @bind="pairsFrom" />
            </label>
            <label>
                Пари до
                <input type="number" min="1" @bind="pairsTo" />
            </label>
        </div>
        <div class="search-actions">
            <button class="primary-button" type="button" @onclick="LoadAsync" disabled="@isLoading">
                @(isLoading ? "Розрахунок…" : "Розрахувати")
            </button>
        </div>
    </section>

    <ErrorAlert Message="@errorMessage" />

    @if (result is not null)
    {
        <section class="schedule-result result-table">
            <div class="result-heading">
                <h2>Аудиторії</h2>
                <span class="period-label">@result.WorkingDays робочих днів · @result.PossiblePairsPerRoom можливих пар</span>
            </div>
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>Корпус</th>
                            <th>Аудиторія</th>
                            <th>Зайнято</th>
                            <th>Пари</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (AuditoriumLoadItemDto item in result.Items)
                        {
                            <tr>
                                <td>@item.BuildingName</td>
                                <td><strong>@item.RoomName</strong></td>
                                <td>@item.Percent.ToString("0.0")%</td>
                                <td>@item.ActualPairs / @item.PossiblePairs</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}

@code {
    private string building = string.Empty;
    private DateOnly fromDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly toDate = DateOnly.FromDateTime(DateTime.Today.AddDays(6));
    private int pairsFrom = 1;
    private int pairsTo = 8;
    private AuditoriumLoadResponse? result;
    private string? errorMessage;
    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        await ReferenceState.EnsureLoadedAsync(ApiClient);
    }

    private async Task LoadAsync()
    {
        if (pairsFrom < 1 || pairsTo < pairsFrom)
        {
            errorMessage = "Діапазон пар некоректний.";
            return;
        }

        isLoading = true;
        errorMessage = null;
        result = null;
        try
        {
            result = await ApiClient.GetAuditoriumLoadAsync(building, fromDate, toDate, pairsFrom, pairsTo);
        }
        catch (Exception exception) when (exception is ScheduleApiException or HttpRequestException)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
