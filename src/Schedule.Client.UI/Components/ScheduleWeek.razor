<section class="week-block">
    <header class="week-block__header">
        <strong>Тиждень @WeekStart.ToString("dd.MM.yyyy") — @WeekStart.AddDays(4).ToString("dd.MM.yyyy")</strong>
    </header>

    <div class="week-grid">
        @for (int offset = 0; offset < 5; offset++)
        {
            DateOnly date = WeekStart.AddDays(offset);
            <ScheduleDay Date="@date" Lessons="@GetLessons(date)" DayName="@GetDayName(date)" />
        }
    </div>
</section>

@code {
    [Parameter]
    public DateOnly WeekStart { get; set; }

    [Parameter]
    public IReadOnlyList<LessonDto> Lessons { get; set; } = [];

    private IReadOnlyList<LessonDto> GetLessons(DateOnly date) => Lessons
        .Where(lesson => lesson.Date == date)
        .ToList();

    private static string GetDayName(DateOnly date) => date.DayOfWeek switch
    {
        DayOfWeek.Monday => "Понеділок",
        DayOfWeek.Tuesday => "Вівторок",
        DayOfWeek.Wednesday => "Середа",
        DayOfWeek.Thursday => "Четвер",
        DayOfWeek.Friday => "П’ятниця",
        _ => date.ToString("dddd"),
    };
}
