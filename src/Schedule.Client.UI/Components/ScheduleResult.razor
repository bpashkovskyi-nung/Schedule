@using System.Globalization

@if (Result.Lessons.Count == 0)
{
    <section class="empty-state">
        <h2>Розклад не знайдено</h2>
        <p>На обраний період занять немає.</p>
    </section>
}
else
{
    <section class="schedule-result">
        <div class="result-heading">
            <div>
                <p class="eyebrow">Результат</p>
                <h2>@Result.ObjectName</h2>
            </div>
            <span class="period-label">@Result.Period.From.ToString("dd.MM.yyyy") — @Result.Period.To.ToString("dd.MM.yyyy")</span>
        </div>

        <div class="days-grid">
            @foreach (IGrouping<DateOnly, LessonDto> day in Result.Lessons
                .Where(x => x.Date.HasValue)
                .GroupBy(x => x.Date!.Value)
                .OrderBy(x => x.Key))
            {
                <ScheduleDay Date="@day.Key" Lessons="@day.ToList()" DayName="@GetDayName(day.Key)" />
            }
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired]
    public ScheduleResponse Result { get; set; } = default!;

    private static string GetDayName(DateOnly date) => date.DayOfWeek switch
    {
        DayOfWeek.Monday => "Понеділок",
        DayOfWeek.Tuesday => "Вівторок",
        DayOfWeek.Wednesday => "Середа",
        DayOfWeek.Thursday => "Четвер",
        DayOfWeek.Friday => "П’ятниця",
        DayOfWeek.Saturday => "Субота",
        DayOfWeek.Sunday => "Неділя",
        _ => date.ToString("dddd", CultureInfo.CurrentCulture),
    };
}
