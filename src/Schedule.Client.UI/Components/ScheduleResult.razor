@using System.Globalization

@if (VisibleLessons.Count == 0)
{
    <section class="empty-state">
        <h2>Розклад не знайдено</h2>
        <p>На обраний період занять немає.</p>
    </section>
}
else
{
    <section class="schedule-result">
        <div class="result-heading">
            <div>
                <p class="eyebrow">Результат</p>
                <h2>@(TitleOverride ?? Result.ObjectName)</h2>
            </div>
            <div class="result-heading__actions">
                <span class="period-label">@Result.Period.From.ToString("dd.MM.yyyy") — @Result.Period.To.ToString("dd.MM.yyyy")</span>
                @if (!string.IsNullOrWhiteSpace(ExportUrl))
                {
                    <a class="secondary-button" href="@ExportUrl" target="_blank" rel="noopener noreferrer">Експорт iCal</a>
                }
            </div>
        </div>

        @if (WeeklyView)
        {
            <div class="weeks-list">
                @foreach (DateOnly weekStart in GetWeekStarts())
                {
                    <ScheduleWeek WeekStart="weekStart" Lessons="@VisibleLessons" />
                }
            </div>
        }
        else
        {
            <div class="days-grid">
                @foreach (IGrouping<DateOnly, LessonDto> day in VisibleLessons
                    .Where(x => x.Date.HasValue)
                    .GroupBy(x => x.Date!.Value)
                    .OrderBy(x => x.Key))
                {
                    <ScheduleDay Date="@day.Key" Lessons="@day.ToList()" DayName="@GetDayName(day.Key)" />
                }
            </div>
        }
    </section>
}

@code {
    [Parameter, EditorRequired]
    public ScheduleResponse Result { get; set; } = default!;

    [Parameter]
    public bool WeeklyView { get; set; }

    [Parameter]
    public string? ExportUrl { get; set; }

    [Parameter]
    public string? TitleOverride { get; set; }

    private IReadOnlyList<LessonDto> VisibleLessons => Result.Lessons
        .Where(lesson => lesson.Date.HasValue && !string.IsNullOrWhiteSpace(lesson.LessonDescription))
        .ToList();

    private IEnumerable<DateOnly> GetWeekStarts()
    {
        DateOnly firstWeek = StartOfWeek(Result.Period.From);
        DateOnly lastWeek = StartOfWeek(Result.Period.To);

        for (DateOnly week = firstWeek; week <= lastWeek; week = week.AddDays(7))
        {
            yield return week;
        }
    }

    private static DateOnly StartOfWeek(DateOnly date)
    {
        int daysFromMonday = ((int)date.DayOfWeek + 6) % 7;
        return date.AddDays(-daysFromMonday);
    }

    private static string GetDayName(DateOnly date) => date.DayOfWeek switch
    {
        DayOfWeek.Monday => "Понеділок",
        DayOfWeek.Tuesday => "Вівторок",
        DayOfWeek.Wednesday => "Середа",
        DayOfWeek.Thursday => "Четвер",
        DayOfWeek.Friday => "П’ятниця",
        DayOfWeek.Saturday => "Субота",
        DayOfWeek.Sunday => "Неділя",
        _ => date.ToString("dddd", CultureInfo.CurrentCulture),
    };
}
