<article class="lesson-card">
    <div class="lesson-card__time">@Lesson.LessonTime</div>
    <div class="lesson-card__content">
        <strong>@GetTitle(Lesson)</strong>
        @if (!string.IsNullOrWhiteSpace(Lesson.LessonDescription) && GetTitle(Lesson) != Lesson.LessonDescription)
        {
            <span>@Lesson.LessonDescription</span>
        }
        @if (!string.IsNullOrWhiteSpace(Lesson.Room) || !string.IsNullOrWhiteSpace(Lesson.Teacher))
        {
            <small>
                @if (!string.IsNullOrWhiteSpace(Lesson.Room))
                {
                    <span>Ауд. @Lesson.Room</span>
                }
                @if (!string.IsNullOrWhiteSpace(Lesson.Room) && !string.IsNullOrWhiteSpace(Lesson.Teacher))
                {
                    <span> · </span>
                }
                @if (!string.IsNullOrWhiteSpace(Lesson.Teacher))
                {
                    <span>@Lesson.Teacher</span>
                }
            </small>
        }
        <LessonLinks Link="Lesson.Link" LinkComment="Lesson.LinkComment" />
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public LessonDto Lesson { get; set; } = default!;

    private static string GetTitle(LessonDto lesson) =>
        FirstNonEmpty(lesson.LessonDescription, lesson.Title, lesson.LessonName, "Заняття");

    private static string FirstNonEmpty(params string[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim() ?? "Заняття";
}
