@model ScheduleIndexViewModel
@{
    ViewData["Title"] = "Розклад занять";
    var roomsByBlock = Model.Reference.Blocks.ToDictionary(
        b => b.Name,
        b => b.Rooms.Select(r => new { id = r.Id, name = r.Name }));
    var teachersByDept = Model.Reference.TeacherDepartments.ToDictionary(
        d => d.Name,
        d => d.Entities.Select(t => new { id = t.Id, name = t.FullName }));
    var groupsByDept = Model.Reference.GroupDepartments.ToDictionary(
        d => d.Name,
        d => d.Entities.Select(g => new { id = g.Id, name = g.Name }));
}

<input type="hidden" id="activeTab" value="@Model.ActiveTab" />

<div class="schedule-container">
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <ul class="nav nav-tabs mb-4" role="tablist">
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "rooms" ? "active" : "")" href="@Url.Content("~/")?tab=rooms" data-schedule-tab="rooms" role="tab">
                <i class="bi bi-building"></i> Аудиторії
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "auditorium-load" ? "active" : "")" href="@Url.Content("~/")?tab=auditorium-load" data-schedule-tab="auditorium-load" role="tab">
                <i class="bi bi-bar-chart"></i> Завантаження аудиторій
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "teachers" ? "active" : "")" href="@Url.Content("~/")?tab=teachers" data-schedule-tab="teachers" role="tab">
                <i class="bi bi-person-badge"></i> Викладачі
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "groups" ? "active" : "")" href="@Url.Content("~/")?tab=groups" data-schedule-tab="groups" role="tab">
                <i class="bi bi-people"></i> Групи
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "teaching-load" ? "active" : "")" href="@Url.Content("~/")?tab=teaching-load" data-schedule-tab="teaching-load" role="tab">
                <i class="bi bi-graph-up"></i> Навчальне навантаження
            </a>
        </li>
    </ul>

    <div class="tab-content">
    @if (Model.ActiveTab == "rooms")
    {
        <div class="tab-pane show active" id="rooms">
            <div class="card">
                <div class="card-body">
                    <form id="roomsForm" data-schedule-form="rooms" asp-action="Rooms" method="get">
                        <div class="form-row">
                            <div class="form-group mb-3">
                                <label class="form-label" for="roomsBlock">Корпус</label>
                                <select class="form-select" id="roomsBlock" name="BlockName" required>
                                    <option value="">Оберіть корпус</option>
                                    @foreach (BuildingVm block in Model.Reference.Blocks)
                                    {
                                        @await Html.PartialAsync("_Option", (block.Name, block.Name, Model.Rooms.BlockName == block.Name))
                                    }
                                </select>
                            </div>
                            <div class="form-group mb-3">
                                <label class="form-label" for="roomsRoom">Аудиторія</label>
                                <select class="form-select" id="roomsRoom" name="RoomId" required>
                                    <option value="">Оберіть аудиторію</option>
                                    @foreach (ScheduleEntityVm room in ScheduleLookup.GetRoomsForBlock(Model.Reference, Model.Rooms.BlockName))
                                    {
                                        @await Html.PartialAsync("_Option", (room.Id, room.Name, Model.Rooms.RoomId == room.Id))
                                    }
                                </select>
                            </div>
                            @{
                                ViewData["PeriodId"] = "roomsPeriod";
                                ViewData["FromId"] = "roomsFrom";
                                ViewData["ToId"] = "roomsTo";
                                ViewData["PeriodOptions"] = Model.PeriodOptions;
                            }
                            @await Html.PartialAsync("_PeriodFields", Model.Rooms)
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Знайти розклад</button>
                    </form>
                </div>
            </div>
            @await Html.PartialAsync("_ScheduleResult", Model.Rooms.Result)
        </div>
    }
    else if (Model.ActiveTab == "auditorium-load")
    {
        <div class="tab-pane show active" id="auditorium-load">
            <div class="card">
                <div class="card-body">
                    <form id="auditoriumsForm" data-schedule-form="auditorium-load" asp-action="AuditoriumLoad" method="get">
                        <div class="form-row auditoriums-load-form-row">
                            <div class="form-group mb-3">
                                <label class="form-label" for="auditoriumsBlock">Корпус</label>
                                <select class="form-select" id="auditoriumsBlock" name="BlockName">
                                    <option value="">Усі корпуси</option>
                                    @foreach (BuildingVm block in Model.Reference.Blocks)
                                    {
                                        @await Html.PartialAsync("_Option", (block.Name, block.Name, Model.AuditoriumLoad.BlockName == block.Name))
                                    }
                                </select>
                            </div>
                            @{
                                ViewData["PeriodId"] = "auditoriumsPeriod";
                                ViewData["FromId"] = "auditoriumsFrom";
                                ViewData["ToId"] = "auditoriumsTo";
                                ViewData["PeriodOptions"] = Model.PeriodOptions;
                            }
                            @await Html.PartialAsync("_PeriodFields", Model.AuditoriumLoad)
                            <div class="form-group mb-3 auditoriums-pairs-group">
                                <label class="form-label" for="pairsFrom">Пари від</label>
                                <input type="number" class="form-control" id="pairsFrom" name="PairsFrom" min="1" value="@Model.AuditoriumLoad.PairsFrom" required />
                            </div>
                            <div class="form-group mb-3 auditoriums-pairs-group">
                                <label class="form-label" for="pairsTo">Пари до</label>
                                <input type="number" class="form-control" id="pairsTo" name="PairsTo" min="1" value="@Model.AuditoriumLoad.PairsTo" required />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Порахувати завантаження</button>
                    </form>
                </div>
            </div>
            @if (Model.AuditoriumLoad.Result is not null)
            {
                <div class="card mt-4">
                    <div class="card-body">
                        <h5 class="mb-0">Завантаження аудиторій</h5>
                        <small class="text-muted">@Model.AuditoriumLoad.Summary</small>
                        <div class="d-flex flex-column gap-3 mt-3">
                            @foreach (AuditoriumLoadItemVm item in Model.AuditoriumLoad.Result.Items)
                            {
                                double percent = Math.Min(100, Math.Max(0, item.Percent));
                                int dayCellSize = Math.Clamp(
                                    280 / Math.Max(1, Model.AuditoriumLoad.Result.Dates.Count),
                                    12,
                                    20);
                                <div class="auditorium-load-item card shadow-none">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <div class="fw-bold">@item.RoomName</div>
                                            <small class="text-muted">@item.BlockDisplayName</small>
                                        </div>
                                        <div class="text-end">
                                            <div class="fw-bold" style="color:@item.HeatColor">@percent.ToString("F1")%</div>
                                            <small class="text-muted">@item.ActualPairs/@item.PossiblePairs пар</small>
                                        </div>
                                    </div>
                                    <div class="mt-2">
                                        <div class="progress" style="height:14px">
                                            <div class="progress-bar" style="width:@(percent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;background-color:@item.HeatColor"></div>
                                        </div>
                                    </div>
                                    <div class="auditorium-load-grid-wrap mt-3">
                                        <table class="auditorium-load-grid" style="--auditorium-cell-size:@(dayCellSize)px" aria-label="Сітка занять аудиторії @item.RoomName">
                                            <thead>
                                                <tr>
                                                    <th scope="col">Пара</th>
                                                    @foreach (DateOnly date in Model.AuditoriumLoad.Result.Dates)
                                                    {
                                                        <th scope="col" title="@date.ToString("dd.MM.yyyy")">@date.ToString("dd")</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @for (int pairNumber = 1; pairNumber <= 8; pairNumber++)
                                                {
                                                    <tr>
                                                        <th scope="row">@pairNumber</th>
                                                        @foreach (DateOnly date in Model.AuditoriumLoad.Result.Dates)
                                                        {
                                                            IReadOnlyList<AuditoriumLoadSlotVm> lessons = item.GetLessons(date, pairNumber);
                                                            bool occupied = lessons.Count > 0;
                                                            string tooltip = occupied
                                                                ? string.Join(Environment.NewLine, lessons.Select(lesson => lesson.Tooltip))
                                                                : $"{date:dd.MM.yyyy} · пара {pairNumber} · вільно";
                                                            <td class="auditorium-load-cell @(occupied ? "occupied" : "free")" title="@tooltip" aria-label="@tooltip">
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (Model.ActiveTab == "teachers")
    {
        <div class="tab-pane show active" id="teachers">
            <div class="card">
                <div class="card-body">
                    <form id="teachersForm" data-schedule-form="teachers" asp-action="Teachers" method="get">
                        <div class="form-row">
                            <div class="form-group mb-3">
                                <label class="form-label" for="teachersDept">Підрозділ</label>
                                <select class="form-select" id="teachersDept" name="DepartmentName" required>
                                    <option value="">Оберіть підрозділ</option>
                                    @foreach (DepartmentVm dept in Model.Reference.TeacherDepartments)
                                    {
                                        @await Html.PartialAsync("_Option", (dept.Name, dept.Name, Model.Teachers.DepartmentName == dept.Name))
                                    }
                                </select>
                            </div>
                            <div class="form-group mb-3">
                                <label class="form-label" for="teachersTeacher">Викладач</label>
                                <select class="form-select" id="teachersTeacher" name="TeacherId" required>
                                    <option value="">Оберіть викладача</option>
                                    @foreach (ScheduleEntityVm t in ScheduleLookup.GetTeachersForDepartment(Model.Reference, Model.Teachers.DepartmentName))
                                    {
                                        @await Html.PartialAsync("_Option", (t.Id, t.FullName, Model.Teachers.TeacherId == t.Id))
                                    }
                                </select>
                            </div>
                            @{
                                ViewData["PeriodId"] = "teachersPeriod";
                                ViewData["FromId"] = "teachersFrom";
                                ViewData["ToId"] = "teachersTo";
                                ViewData["PeriodOptions"] = Model.PeriodOptions;
                            }
                            @await Html.PartialAsync("_PeriodFields", Model.Teachers)
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Знайти розклад</button>
                    </form>
                </div>
            </div>
            @await Html.PartialAsync("_ScheduleResult", Model.Teachers.Result)
        </div>
    }
    else if (Model.ActiveTab == "groups")
    {
        <div class="tab-pane show active" id="groups">
            <div class="card">
                <div class="card-body">
                    <form id="groupsForm" data-schedule-form="groups" asp-action="Groups" method="get">
                        <div class="form-row">
                            <div class="form-group mb-3">
                                <label class="form-label" for="groupsDept">Підрозділ</label>
                                <select class="form-select" id="groupsDept" name="DepartmentName" required>
                                    <option value="">Оберіть підрозділ</option>
                                    @foreach (DepartmentVm dept in Model.Reference.GroupDepartments)
                                    {
                                        @await Html.PartialAsync("_Option", (dept.Name, dept.Name, Model.Groups.DepartmentName == dept.Name))
                                    }
                                </select>
                            </div>
                            <div class="form-group mb-3">
                                <label class="form-label" for="groupsGroup">Група</label>
                                <select class="form-select" id="groupsGroup" name="GroupId" required>
                                    <option value="">Оберіть групу</option>
                                    @foreach (ScheduleEntityVm g in ScheduleLookup.GetGroupsForDepartment(Model.Reference, Model.Groups.DepartmentName))
                                    {
                                        @await Html.PartialAsync("_Option", (g.Id, g.Name, Model.Groups.GroupId == g.Id))
                                    }
                                </select>
                            </div>
                            @{
                                ViewData["PeriodId"] = "groupsPeriod";
                                ViewData["FromId"] = "groupsFrom";
                                ViewData["ToId"] = "groupsTo";
                                ViewData["PeriodOptions"] = Model.PeriodOptions;
                            }
                            @await Html.PartialAsync("_PeriodFields", Model.Groups)
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Знайти розклад</button>
                    </form>
                </div>
            </div>
            @await Html.PartialAsync("_ScheduleResult", Model.Groups.Result)
        </div>
    }
    else if (Model.ActiveTab == "teaching-load")
    {
        <div class="tab-pane show active" id="teaching-load">
            <div class="card">
                <div class="card-body">
                    <form id="teachingLoadForm" data-schedule-form="teaching-load" asp-action="TeachingLoad" method="get">
                        <div class="form-row">
                            <div class="form-group mb-3">
                                <label class="form-label" for="teachingLoadDept">Підрозділ</label>
                                <select class="form-select" id="teachingLoadDept" name="DepartmentName" required>
                                    <option value="">Оберіть підрозділ</option>
                                    @foreach (DepartmentVm dept in Model.Reference.TeacherDepartments)
                                    {
                                        @await Html.PartialAsync("_Option", (dept.Name, dept.Name, Model.TeachingLoad.DepartmentName == dept.Name))
                                    }
                                </select>
                            </div>
                            @{
                                ViewData["PeriodId"] = "teachingLoadPeriod";
                                ViewData["FromId"] = "teachingLoadFrom";
                                ViewData["ToId"] = "teachingLoadTo";
                                ViewData["PeriodOptions"] = Model.PeriodOptions;
                            }
                            @await Html.PartialAsync("_PeriodFields", Model.TeachingLoad)
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Розрахувати навантаження</button>
                    </form>
                </div>
            </div>
            @if (Model.TeachingLoad.Result is not null)
            {
                <div class="card mt-4">
                    <div class="card-body">
                        <h5 class="mb-3">Навчальне навантаження викладачів</h5>
                        <small class="text-muted d-block mb-3">Кількість годин (кількість пар × 2)</small>
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Викладач</th>
                                        @foreach (string sessionType in Model.TeachingLoad.Result.SessionTypes)
                                        {
                                            <th class="text-center">@sessionType</th>
                                        }
                                        <th class="text-center table-primary">Всього</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (TeachingLoadRowVm row in Model.TeachingLoad.Result.Rows)
                                    {
                                        <tr>
                                            <td class="fw-bold">@row.TeacherName</td>
                                            @foreach (string sessionType in Model.TeachingLoad.Result.SessionTypes)
                                            {
                                                <td class="text-center">@row.HoursByType.GetValueOrDefault(sessionType)</td>
                                            }
                                            <td class="text-center fw-bold table-primary">@row.TotalHours</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    </div>
</div>

<script type="application/json" id="roomsByBlockJson">@Html.Raw(JsonSerializer.Serialize(roomsByBlock))</script>
<script type="application/json" id="teachersByDeptJson">@Html.Raw(JsonSerializer.Serialize(teachersByDept))</script>
<script type="application/json" id="groupsByDeptJson">@Html.Raw(JsonSerializer.Serialize(groupsByDept))</script>
